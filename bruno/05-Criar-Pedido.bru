meta {
  name: 05-Criar-Pedido
  type: http
  seq: 5
}

post {
  url: {{order_url}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "item": "Kit Manutenção Aviônica Garmin G1000",
    "quantity": 1,
    "totalPrice": 14500.00
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.item: eq Kit Manutenção Aviônica Garmin G1000
  res.body.status: eq CREATED
}

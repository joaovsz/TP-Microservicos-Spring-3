meta {
  name: 06-Refresh-Token
  type: http
  seq: 6
}

post {
  url: {{auth_url}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.refreshToken: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("access_token", res.body.accessToken);
    bru.setEnvVar("refresh_token", res.body.refreshToken);
  }
}
